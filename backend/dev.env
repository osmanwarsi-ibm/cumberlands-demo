# Development Environment Configuration
# This file contains working defaults for local development.
# Copy to .env and customize if needed: cp dev.env .env

# Database Configuration
DATABASE_URL=sqlite:///./data/reconciliation.db

# Application Configuration
APP_ENV=pilot_local

# Fixture Configuration
FIXTURE_ROOT=./fixtures

# AI Triage Configuration
TRIAGE_MODE=MOCK

# Authentication Configuration
AUTH_STUB_ENABLED=true

# Default Batch Source for Smoke Test
DEFAULT_BATCH_SOURCE=pilot_batch_01

# JWT Configuration (placeholder for pilot)
SECRET_KEY=pilot-dev-secret-key-change-in-production
