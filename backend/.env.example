# Database Configuration
# Optional: defaults to sqlite:///./data/reconciliation.db
# For production with PostgreSQL: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/reconciliation.db

# Application Configuration
# Optional: defaults to pilot_local
APP_ENV=pilot_local

# Fixture Configuration
# Optional: defaults to ./fixtures
FIXTURE_ROOT=./fixtures

# AI Triage Configuration
# Optional: MOCK (default) or LLM
TRIAGE_MODE=MOCK

# Optional: Only required when TRIAGE_MODE=LLM
# TRIAGE_PROVIDER_API_KEY=your-api-key-here

# Authentication Configuration
# Optional: defaults to true for pilot
AUTH_STUB_ENABLED=true

# Default Batch Source for Smoke Test
# Optional: defaults to pilot_batch_01
DEFAULT_BATCH_SOURCE=pilot_batch_01

# JWT Configuration (for future use)
# SECRET_KEY=change-this-to-a-random-secret-key
